abstract class LibraryItem {

    protected String title;
    protected int itemId;
    protected boolean isIssued;

    public LibraryItem(String title, int itemId) {
        this.title = title;
        this.itemId = itemId;
        this.isIssued = false;
    }

    public abstract int calculateFine(int daysLate);

    public void displayInfo() {
        System.out.println("Title: " + title + ", ID: " + itemId + ", Issued: " + isIssued);
    }

    public String getTitle() {
        return title;
    }

    public int getItemId() {
        return itemId;
    }

    public boolean isIssued() {
        return isIssued;
    }

    public void setIssued(boolean issued) {
        isIssued = issued;
    }
}

interface Issuable {
    void issueItem();
    void returnItem();
}

class Book extends LibraryItem implements Issuable {

    public Book(String title, int itemId) {
        super(title, itemId);
    }

    public int calculateFine(int daysLate) {
        return daysLate * 5;
    }

    public void issueItem() {
        setIssued(true);
    }

    public void returnItem() {
        setIssued(false);
    }

    public String toString() {
        return "Item : " + title + " (Book)";
    }
}

class Magazine extends LibraryItem implements Issuable {

    public Magazine(String title, int itemId) {
        super(title, itemId);
    }

    public int calculateFine(int daysLate) {
        return daysLate * 2;
    }

    public void issueItem() {
        setIssued(true);
    }

    public void returnItem() {
        setIssued(false);
    }

    public String toString() {
        return "Item : " + title + " (Magazine)";
    }
}

public class AssignmentP5 {

    public static void main(String[] args) {

        LibraryItem[] items = new LibraryItem[4];

        items[0] = new Book("Java Programming", 101);
        items[1] = new Magazine("National Geographic", 201);
        items[2] = new Book("Clean Code", 102);
        items[3] = new Magazine("Time Magazine", 202);

        ((Issuable) items[0]).issueItem();
        ((Issuable) items[1]).issueItem();
        ((Issuable) items[2]).issueItem();
        ((Issuable) items[3]).issueItem();

        int[] lateDays = {4, 4, 2, 2};

        for (int i = 0; i < items.length; i++) {
            int fine = items[i].calculateFine(lateDays[i]);
            System.out.println(items[i].toString() + " | Fine for " + lateDays[i] + " days late : Rs." + fine);
        }
    }
}
